# Copy to api/.env (gitignored). Never commit real values.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only, never in web/>
SUPABASE_BUCKET=pipe-images
# Comma-separated, no "*". Add http://<laptop-ip>:5173 for phone-on-LAN testing.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Mock detector seed (non-secret). 0 = default.
MOCK_SEED=0
